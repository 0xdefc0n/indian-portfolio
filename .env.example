# Get a key from https://casparser.in (CDSL OTP fetch needs the Pro plan).
# The sandbox key returns mock data and uses no credits.
CASPARSER_API_KEY=sandbox-with-json-responses
# Monthly statements to fetch per request (CASParser default is 6). 1 = latest only.
NUM_PERIODS=1

# Optional: request KFintech statements from the app (free plan: 25 requests/month).
# Subscribe at https://rapidapi.com/sameer.kumar/api/kfintech-cas-mailback-automation
# Without it, the app guides you through KFintech's website instead.
RAPIDAPI_KEY=

# Rebuild the value chart from CAMS/KFintech transactions using daily NAVs from api.mfapi.in
# (only fund codes are sent). Set to 0 to use CDSL month-end values only.
NAV_HISTORY=1

# Stocks inside each fund (https://bharatstockapi.com). Leave empty to turn off.
# Fetched once, refreshed only when a fund house publishes a newer month; capped per day.
BHARATSTOCK_API_KEY=
BHARATSTOCK_DAILY_LIMIT=50
