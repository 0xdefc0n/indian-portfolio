# Copy to worker/.dev.vars (git-ignored) and fill in. Names only here, never values.
# Plan §15.2. Generated by Claude in M4 unless noted.

# Auth (M5)
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=            # owner: Google Cloud OAuth Web client (one per environment)
GOOGLE_CLIENT_SECRET=        # owner
RESEND_API_KEY=              # owner: Resend, sending access
STAGING_GOOGLE_CLIENT_ID=     # owner: staging OAuth client (pushed to staging with `wrangler secret put` in M5)
STAGING_GOOGLE_CLIENT_SECRET= # owner
TEST_EMAIL_1=                # owner: inboxes you can read, for sign-in tests (M5)
TEST_EMAIL_2=
TURNSTILE_SECRET=            # created in M4

# Encryption (M4/M6). Back up DATA_KEK_V1 and PAN_PEPPER in a password manager: losing them makes all data unreadable.
DATA_KEK_V1=
PAN_PEPPER=

# Worker -> engine (M2)
ENGINE_SHARED_SECRET=

# Market data (M10, M11)
R2_MARKET_READONLY_ACCESS_KEY_ID=      # owner, unless the Cloudflare token can create it
R2_MARKET_READONLY_SECRET_ACCESS_KEY=
BHARATSTOCK_API_KEY=                   # owner

# Deploy (M4), also stored as GitHub Actions secrets
CLOUDFLARE_API_TOKEN=        # owner
CLOUDFLARE_ACCOUNT_ID=       # owner

# Local tests only (M3): password of a private test PDF in data/ or engine/tests/private/
TEST_PDF_PASSWORD=
