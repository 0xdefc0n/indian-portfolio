# Copy to worker/.dev.vars (git-ignored) and fill in. Names only here, never values.
# Plan §15.2. Generated by Claude in M4 unless noted.

# Auth (M5). Email needs no key: Cloudflare Email Service via the send_email binding (plan D5).
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=            # owner: Google Cloud OAuth Web client (one per environment)
GOOGLE_CLIENT_SECRET=        # owner
STAGING_GOOGLE_CLIENT_ID=     # owner: staging OAuth client (pushed to staging with `wrangler secret put` in M5)
STAGING_GOOGLE_CLIENT_SECRET= # owner
TEST_EMAIL_1=                # owner: inboxes you can read, for sign-in tests (M5)
TEST_EMAIL_2=
TURNSTILE_SECRET=            # created in M4. Locally: 1x0000000000000000000000000000000AA (Cloudflare's always-pass test secret)
EMAIL_SINK_KEY=              # local test email sink (M5): openssl rand -hex 32. Never set in production
STAGING_EMAIL_SINK_KEY=      # the value pushed to staging as EMAIL_SINK_KEY; scripts/auth-smoke.ts uses it

# Encryption (M4/M6). Back up the STAGING/PRODUCTION DATA_KEK_V1 and PAN_PEPPER in a password manager: losing them makes all
# data unreadable. Locally use your own random values (openssl rand -hex 32); never the cloud ones.
DATA_KEK_V1=
PAN_PEPPER=

# Worker -> engine (M2)
ENGINE_SHARED_SECRET=

# Market data (M11). The engine reads NAVs through MarketGateway (M10), so it needs no R2 keys.
BHARATSTOCK_API_KEY=                   # owner

# Deploy (M4), also stored as GitHub Actions secrets
CLOUDFLARE_API_TOKEN=        # owner
CLOUDFLARE_ACCOUNT_ID=       # owner

# Local tests only (M3): password of a private test PDF in data/ or engine/tests/private/
TEST_PDF_PASSWORD=
